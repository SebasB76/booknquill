{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BookNQuill",
  "version": "0.1.0",
  "identifier": "io.github.sebasb76.booknquill",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BookNQuill",
        "width": 1180,
        "height": 780,
        "minWidth": 560,
        "minHeight": 420,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "Productivity",
    "shortDescription": "A quiet notes app",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
